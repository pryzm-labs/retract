# Optional developer/CI overrides. Normal setup is performed in Retract's UI.
# Active values take precedence over UI settings after restart.
# Obtain development credentials from https://my.telegram.org.
RETRACT_TELEGRAM_API_ID=
RETRACT_TELEGRAM_API_HASH=
# Mandatory for destructive integration testing; omit for a production account.
RETRACT_TELEGRAM_TEST_DC=1
