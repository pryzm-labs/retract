# Deny by default. Only inputs explicitly consumed by the reviewed build and
# repository checks may enter BuildKit's context or caches.
**
!.dockerignore
!.env.example
!.github/
!.github/**
!.gitignore
!.nvmrc
!.retract-tracked-context
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!Dockerfile
!LICENSE
!PLAN.md
!README.md
!SECURITY.md
!THIRD_PARTY_NOTICES.md
!assets/
!assets/**
!crates/
!crates/**
!docs/
!docs/**
!index.html
!package-lock.json
!package.json
!rust-toolchain.toml
!scripts/
!scripts/**
!src/
!src/**
!src-tauri/
!src-tauri/**
!tsconfig.json
!vendor/
!vendor/nanoid/
!vendor/nanoid/**
!vendor/sqlcipher/
!vendor/sqlcipher/**
!vendor/tdlib-dist/
!vendor/tdlib-dist/**
!vite.config.ts
!vitest.config.ts

# Explicitly keep mutable, generated, secret-bearing, and heavyweight paths
# out even when they sit below one of the reviewed source directories above.
.env
.env.*
!.env.example
**/.DS_Store
**/*.db
**/*.db-shm
**/*.db-wal
**/*.hold
**/*.log
**/target/
artifacts/
dist/
node_modules/
src-tauri/gen/
src-tauri/tdlib-data/
vendor/tdlib-source/
