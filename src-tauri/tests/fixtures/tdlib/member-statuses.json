    "expectedLeave": true
  },
  {
    "name": "restricted-nonmember",
    "status": { "@type": "chatMemberStatusRestricted", "is_member": false },
    "expectedRole": "member",
    "expectedDelete": false,
    "expectedLeave": false
  },
  {
    "name": "left",
    "status": { "@type": "chatMemberStatusLeft" },
