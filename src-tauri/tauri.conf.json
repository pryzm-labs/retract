{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retract",
  "version": "0.1.0",
  "identifier": "app.retract.cleaner",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Retract",
        "width": 1320,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/tdlib-dist/libtdjson.dylib": "lib/libtdjson.dylib",
      "../vendor/tdlib-dist/TDLib-LICENSE_1_0.txt": "licenses/TDLib-LICENSE_1_0.txt",
      "../vendor/tdlib-dist/build-stamp.txt": "licenses/TDLib-build-stamp.txt"
    },
    "category": "Utility",
    "shortDescription": "Local-first Telegram history cleanup",
    "longDescription": "Search and remove Telegram history using explicit, capability-checked deletion plans.",
    "copyright": "Copyright © 2026 Pryzm Labs",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
